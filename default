server {
    listen 8080;
    listen [::]:8080;
    root /home/site/wwwroot;
    index index.php index.html index.htm;
    server_name _;

    # Force HTTPS for all requests
    if ($http_x_forwarded_proto != "https") {
        return 301 https://$host$request_uri;
    }

    # Handle /backadm-dmc requests - route to Laravel public folder
    location ^~ /backadm-dmc/ {
        alias /home/site/wwwroot/backadm-dmc/public/;
        try_files $uri $uri/ @backadm_dmc_fallback;
        
        # Handle PHP files in Laravel
        location ~ \.php$ {
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME /home/site/wwwroot/backadm-dmc/public/index.php;
            fastcgi_param SCRIPT_NAME /backadm-dmc/index.php;
            fastcgi_param REQUEST_URI $request_uri;
            fastcgi_param HTTPS on;
            fastcgi_param SERVER_PORT 443;
            fastcgi_param HTTP_X_FORWARDED_PROTO https;
            fastcgi_pass 127.0.0.1:9000;
        }
    }
    
    # Handle exact /backadm-dmc (without trailing slash)
    location = /backadm-dmc {
        return 301 $scheme://$host/backadm-dmc/;
    }
    
    # Fallback for Laravel routing
    location @backadm_dmc_fallback {
        rewrite ^/backadm-dmc/(.*)$ /backadm-dmc/index.php?/$1 last;
    }

    # Handle other requests normally
    location / {
        try_files $uri $uri/ =404;
    }

    # Handle PHP files in root
    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTPS on;
        fastcgi_param SERVER_PORT 443;
        fastcgi_param HTTP_X_FORWARDED_PROTO https;
        fastcgi_pass 127.0.0.1:9000;
    }

    # Security headers
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;
    add_header X-XSS-Protection "1; mode=block";
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
}
