server {
    listen 8080;
    server_name _;
    root /home/site/wwwroot;
    index index.php index.html;
    
    # Increase timeouts for slow API calls
    proxy_connect_timeout 300s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;
    fastcgi_connect_timeout 300s;
    fastcgi_send_timeout 300s;
    fastcgi_read_timeout 300s;
    
    # Increase buffer sizes for large responses
    fastcgi_buffer_size 128k;
    fastcgi_buffers 4 256k;
    fastcgi_busy_buffers_size 256k;
    
    # Client timeouts
    client_body_timeout 300s;
    client_header_timeout 300s;
    send_timeout 300s;
    
    # Enable gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/javascript application/xml+rss application/json;
    
    # Force HTTPS
    if ($http_x_forwarded_proto != "https") {
        return 301 https://$host$request_uri;
    }

    # Handle /backadm-dmc requests - route to Laravel public folder
    location ^~ /backadm-dmc/ {
        alias /home/site/wwwroot/backadm-dmc/public/;
        index index.php;
        try_files $uri $uri/ @backadm_dmc_fallback;
        
        # Handle PHP files in Laravel
        location ~ \.php$ {
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME /home/site/wwwroot/backadm-dmc/public/index.php;
            fastcgi_param SCRIPT_NAME /backadm-dmc/index.php;
            fastcgi_param REQUEST_URI $request_uri;
            fastcgi_param HTTPS on;
            fastcgi_param SERVER_PORT 443;
            fastcgi_param HTTP_X_FORWARDED_PROTO https;
            
            # Optimize for API performance
            fastcgi_connect_timeout 300s;
            fastcgi_send_timeout 300s;
            fastcgi_read_timeout 300s;
            fastcgi_buffer_size 128k;
            fastcgi_buffers 4 256k;
            fastcgi_busy_buffers_size 256k;
            
            fastcgi_pass 127.0.0.1:9000;
        }
    }
    
    # Handle exact /backadm-dmc (without trailing slash)
    location = /backadm-dmc {
        return 301 $scheme://$host/backadm-dmc/;
    }
    
    # Fallback for Laravel routing - send everything to index.php
    location @backadm_dmc_fallback {
        rewrite ^/backadm-dmc/(.*)$ /backadm-dmc/index.php last;
    }

    # Handle other requests normally
    location / {
        try_files $uri $uri/ =404;
    }

    # Handle PHP files in root
    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTPS on;
        fastcgi_param SERVER_PORT 443;
        fastcgi_param HTTP_X_FORWARDED_PROTO https;
        fastcgi_pass 127.0.0.1:9000;
    }

    # Security headers
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;
    add_header X-XSS-Protection "1; mode=block";
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
}
