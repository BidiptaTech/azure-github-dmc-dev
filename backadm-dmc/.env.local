# Local Development Environment Configuration
# Copy this file to .env.local for localhost development with XAMPP
# Azure Key Vault is disabled for local development

# Disable Azure Key Vault for local development
USE_AZURE_KEYVAULT=false

# Application Configuration
APP_NAME=Travclicks
APP_ENV=local
APP_KEY=base64:Tb7XcZnK34NLjyM8ILqL1P6jEWaUmI0KXpTwHMI4Xg4=
APP_DEBUG=true
APP_URL=http://localhost/dev_dmc/public

# Logging Configuration
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration (XAMPP MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dmc_local
DB_USERNAME=root
DB_PASSWORD=

# Broadcast, Cache, Filesystem, Queue, Session
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Memory Cache
MEMCACHED_HOST=127.0.0.1

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration (Local testing - use Mailtrap or similar)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="admin@travclicks.local"
MAIL_FROM_NAME="${APP_NAME}"

# AWS Configuration (not used in local)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher Configuration (not used in local)
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Vite Configuration
VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Application Theme Settings
APP_CAPTION_SHOW='true'
APP_DARK_NAVBAR='false'
APP_PRESET_THEME="preset-1"
APP_DARK_LAYOUT='false'
APP_RTL_LAYOUT='false'
APP_BOX_CONTAINER='false'

# FreeCurrency API
FREECURRENCYAPI_KEY='fca_live_RHY03wHdEiYdoOqi9h7dUewwS7oDWA0VxTRaUeb2'

# Azure Configuration (not used in local development)
AZURE_STORAGE_NAME=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_ENDPOINT=
AZURE_KEYVAULT_NAME=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID= 