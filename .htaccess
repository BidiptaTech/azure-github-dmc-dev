RewriteEngine On

# ========================
# Laravel Backend Routing
# ========================
# Redirect /backadm-dmc to Laravel public directory
RewriteRule ^backadm-dmc/?(.*)$ backadm-dmc/public/$1 [L,QSA]

# ========================
# React Frontend Routing
# ========================
# If request is NOT a real file or folder
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Redirect everything else to index.html (React entry point)
RewriteRule ^ index.html [L]
