<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- URL Rewrite Rules for Linux Azure App Service -->
    <rewrite>
      <rules>
        <!-- Force HTTPS (only for production) -->
        <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)"/>
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true"/>
            <add input="{HTTP_HOST}" pattern="localhost" negate="true"/>
            <add input="{HTTP_HOST}" pattern="127.0.0.1" negate="true"/>
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent"/>
        </rule>

        <!-- Route /backadm-dmc to Laravel public folder -->
        <rule name="Laravel App Route" stopProcessing="true">
          <match url="^backadm-dmc/?(.*)$"/>
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true"/>
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true"/>
          </conditions>
          <action type="Rewrite" url="backadm-dmc/public/index.php/{R:1}"/>
        </rule>

        <!-- Direct access to Laravel public assets -->
        <rule name="Laravel Public Assets" stopProcessing="true">
          <match url="^backadm-dmc/public/(.*)$"/>
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile"/>
          </conditions>
          <action type="Rewrite" url="backadm-dmc/public/{R:1}"/>
        </rule>

        <!-- Handle Laravel public folder directly -->
        <rule name="Laravel Public Direct" stopProcessing="true">
          <match url="^backadm-dmc/(.*)$"/>
          <conditions>
            <add input="backadm-dmc/public/{R:1}" matchType="IsFile"/>
          </conditions>
          <action type="Rewrite" url="backadm-dmc/public/{R:1}"/>
        </rule>
      </rules>
    </rewrite>

    <!-- Default Documents -->
    <defaultDocument>
      <files>
        <clear/>
        <add value="index.html"/>
        <add value="index.php"/>
        <add value="default.html"/>
      </files>
    </defaultDocument>

    <!-- HTTP Headers for security and performance -->
    <httpHeaders>
      <add name="X-Content-Type-Options" value="nosniff"/>
      <add name="X-Frame-Options" value="SAMEORIGIN"/>
      <add name="X-XSS-Protection" value="1; mode=block"/>
      <add name="Referrer-Policy" value="strict-origin-when-cross-origin"/>
    </httpHeaders>

    <!-- Handle errors -->
    <httpErrors>
      <remove statusCode="404" subStatusCode="-1"/>
      <error statusCode="404" prefixLanguageFilePath="" path="/index.html" responseMode="ExecuteURL"/>
    </httpErrors>

    <!-- Static content caching -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00"/>
    </staticContent>
  </system.webServer>
</configuration> 