<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- URL Rewrite Rules for subdirectory routing -->
    <rewrite>
      <rules>
        <!-- Force HTTPS (only for production) -->
        <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
            <add input="{HTTP_HOST}" pattern="localhost" negate="true" />
            <add input="{HTTP_HOST}" pattern="127.0.0.1" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Route /backadm-dmc requests to Laravel public folder -->
        <rule name="Laravel App Route" stopProcessing="true">
          <match url="^backadm-dmc(/.*)?$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="backadm-dmc/public/index.php{R:1}" />
        </rule>

        <!-- Direct access to Laravel public folder -->
        <rule name="Laravel Public Direct" stopProcessing="true">
          <match url="^backadm-dmc/public/(.*)$" />
          <action type="Rewrite" url="backadm-dmc/public/{R:1}" />
        </rule>

        <!-- Test files routing -->
        <rule name="Test Files" stopProcessing="true">
          <match url="^(test-.*\.(html|php))$" />
          <action type="Rewrite" url="{R:1}" />
        </rule>

        <!-- Default route for root - can redirect to React app or show default page -->
        <rule name="Root Route" stopProcessing="true">
          <match url="^$" />
          <action type="Rewrite" url="test-azure.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Default Documents -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
        <add value="index.html" />
        <add value="test-azure.html" />
      </files>
    </defaultDocument>

    <!-- Directory Browsing -->
    <directoryBrowse enabled="false" />

    <!-- Error Handling -->
    <httpErrors errorMode="Detailed">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="/test-azure.html" responseMode="ExecuteURL" />
    </httpErrors>

    <!-- Security Headers -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-XSS-Protection" value="1; mode=block" />
      </customHeaders>
    </httpProtocol>

    <!-- Static Content -->
    <staticContent>
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff2" />
    </staticContent>
  </system.webServer>
</configuration> 