import React, { useState, useEffect } from 'react';
import { useSelector, useDispatch } from 'react-redux';
import { 
  Box, Typography, Grid, Card, CardContent, CardMedia, 
  Divider, Button, FormControlLabel, Checkbox, TextField, 
  Paper, MenuItem, Select, FormControl, InputLabel, Avatar, 
  AvatarGroup, Chip, CircularProgress
} from '@mui/material';
import moment from 'moment';
import HotelIcon from '@mui/icons-material/Hotel';
import PersonIcon from '@mui/icons-material/Person';
import WomanIcon from '@mui/icons-material/Woman';
import ChildCareIcon from '@mui/icons-material/ChildCare';
import BabyChangingStationIcon from '@mui/icons-material/BabyChangingStation';
import ContentCopyIcon from '@mui/icons-material/ContentCopy';
import DeleteIcon from '@mui/icons-material/Delete';
import AddIcon from '@mui/icons-material/Add';

export default function HotelComponent() {
  const dispatch = useDispatch();
  
  // States
  const [selectedHotel, setSelectedHotel] = useState('');
  const [roomType, setRoomType] = useState('');
  const [bedType, setBedType] = useState('');
  const [occupancyType, setOccupancyType] = useState('single');
  const [mealPlan, setMealPlan] = useState('self');
  const [babyCotSelected, setBabyCotSelected] = useState(false);
  const [adultDistribution, setAdultDistribution] = useState({
    male: 0,
    female: 0
  });
  const [mealPlanPerPerson, setMealPlanPerPerson] = useState([]);
  
  // Get data from Redux store
  const searchCriteria = useSelector(state => state.tourPackages?.searchCriteria || {});
  const selectedCity = useSelector(state => state.common?.selectedCity?.cityName);
  const selectedCountry = useSelector(state => state.common?.selectedCity?.countryName);
  
  // Initialize adult distribution when component mounts or search criteria changes
  useEffect(() => {
    const adults = parseInt(searchCriteria?.guests?.adults || 1);
    setAdultDistribution({
      male: Math.ceil(adults / 2),
      female: Math.floor(adults / 2)
    });
    
    // Initialize meal plan for each person
    const initialMealPlans = [];
    for (let i = 0; i < adults; i++) {
      initialMealPlans.push('self'); // Default to 'self' (Room Only)
    }
    setMealPlanPerPerson(initialMealPlans);
  }, [searchCriteria]);
  
  // Mock hotel data
  const mockHotels = [
    { id: '1', name: 'Hotel Boss', location: 'Little India • 3 Star', image: 'https://source.unsplash.com/random/600x400/?hotel' },
    { id: '2', name: 'Grand Marina', location: 'Downtown • 4 Star', image: 'https://source.unsplash.com/random/600x401/?hotel' },
    { id: '3', name: 'Luxury Palace', location: 'City Center • 5 Star', image: 'https://source.unsplash.com/random/600x402/?hotel' }
  ];
  
  // Mock room types
  const mockRoomTypes = [
    { id: '1', name: 'Standard Room', hotel_id: '1' },
    { id: '2', name: 'Deluxe Room', hotel_id: '1' },
    { id: '3', name: 'Executive Suite', hotel_id: '1' },
    { id: '4', name: 'Standard Room', hotel_id: '2' },
    { id: '5', name: 'Premium Room', hotel_id: '2' },
    { id: '6', name: 'Luxury Suite', hotel_id: '2' },
    { id: '7', name: 'Standard Room', hotel_id: '3' },
    { id: '8', name: 'Deluxe Room', hotel_id: '3' },
    { id: '9', name: 'Presidential Suite', hotel_id: '3' },
  ];
  
  // Mock bed types
  const mockBedTypes = [
    { id: '1', name: 'Single Bed', room_type_id: '1', max_occupancy: 1 },
    { id: '2', name: 'Queen Bed', room_type_id: '1', max_occupancy: 2 },
    { id: '3', name: 'Twin Beds', room_type_id: '2', max_occupancy: 2 },
    { id: '4', name: 'King Bed', room_type_id: '2', max_occupancy: 2 },
    { id: '5', name: 'Triple Beds', room_type_id: '3', max_occupancy: 3 },
    { id: '6', name: 'Single Bed', room_type_id: '4', max_occupancy: 1 },
    { id: '7', name: 'Double Bed', room_type_id: '4', max_occupancy: 2 },
    { id: '8', name: 'Twin Beds', room_type_id: '5', max_occupancy: 2 },
    { id: '9', name: 'King Bed', room_type_id: '5', max_occupancy: 2 },
    { id: '10', name: 'Triple Beds', room_type_id: '6', max_occupancy: 3 },
    { id: '11', name: 'Single Bed', room_type_id: '7', max_occupancy: 1 },
    { id: '12', name: 'Queen Bed', room_type_id: '7', max_occupancy: 2 },
    { id: '13', name: 'Twin Beds', room_type_id: '8', max_occupancy: 2 },
    { id: '14', name: 'King Bed', room_type_id: '8', max_occupancy: 2 },
    { id: '15', name: 'Triple Beds', room_type_id: '9', max_occupancy: 3 },
  ];
  
  // Generate dates array from the selected date range
  const dates = React.useMemo(() => {
    if (!searchCriteria?.checkIn || !searchCriteria?.checkOut) return [];
    
    const startDate = moment(searchCriteria.checkIn, 'DD/MM/YYYY');
    const endDate = moment(searchCriteria.checkOut, 'DD/MM/YYYY');
    const dayDiff = endDate.diff(startDate, 'days');
    
    // Generate an array of all dates in the range
    const datesArray = [];
    for (let i = 0; i <= dayDiff; i++) {
      datesArray.push(moment(startDate).add(i, 'days'));
    }
    return datesArray;
  }, [searchCriteria]);
  
  // Handle hotel selection change
  const handleHotelChange = (event) => {
    setSelectedHotel(event.target.value);
  };
  
  // Handle meal plan selection from cards
  const handleMealPlanCardSelect = (mealType) => {
    setMealPlan(mealType);
    
    // Update meal plan for all persons to match
    if (mealPlanPerPerson.length > 0) {
      const newMealPlans = mealPlanPerPerson.map(() => mealType);
      setMealPlanPerPerson(newMealPlans);
    }
  };
  
  // Handle baby cot toggle
  const handleBabyCotToggle = () => {
    setBabyCotSelected(!babyCotSelected);
  };
  
  // If no dates available, show a message
  if (dates.length === 0) {
    return (
      <Paper sx={{ p: 4, textAlign: 'center' }}>
        <Typography variant="h5">
          Please select travel dates to view your hotel options
        </Typography>
      </Paper>
    );
  }
  
  // Get the selected hotel details
  const getSelectedHotelDetails = () => {
    return mockHotels.find(hotel => hotel.id === selectedHotel) || mockHotels[0];
  };
  
  const hotelDetails = getSelectedHotelDetails();
  
  return (
    <Box>
      {/* Hotel Selection & Room Configuration */}
      <Grid container spacing={2} sx={{ mb: 3 }}>
        <Grid item xs={12} md={4}>
          <Typography variant="subtitle1" fontWeight={500}>Select Hotel</Typography>
          <FormControl fullWidth sx={{ mt: 2 }}>
            <InputLabel id="hotel-select-label">Hotel</InputLabel>
            <Select
              labelId="hotel-select-label"
              id="hotel-select"
              value={selectedHotel}
              label="Hotel"
              onChange={(e) => {
                setSelectedHotel(e.target.value);
                setRoomType(''); // Reset room type when hotel changes
                setBedType(''); // Reset bed type when hotel changes
              }}
            >
              <MenuItem value="">
                <em>Select a hotel</em>
              </MenuItem>
              {mockHotels.map((hotel) => (
                <MenuItem key={hotel.id} value={hotel.id}>
                  {hotel.name}
                </MenuItem>
              ))}
            </Select>
          </FormControl>
        </Grid>
        
        <Grid item xs={12} md={4}>
          <Typography variant="subtitle1" fontWeight={500}>Select Room Type</Typography>
          <FormControl fullWidth sx={{ mt: 2 }} disabled={!selectedHotel}>
            <InputLabel id="room-type-select-label">Room Type</InputLabel>
            <Select
              labelId="room-type-select-label"
              id="room-type-select"
              value={roomType}
              label="Room Type"
              onChange={(e) => {
                setRoomType(e.target.value);
                setBedType(''); // Reset bed type when room type changes
              }}
            >
              <MenuItem value="">
                <em>Select a room type</em>
              </MenuItem>
              {mockRoomTypes
                .filter(room => room.hotel_id === selectedHotel)
                .map((room) => (
                  <MenuItem key={room.id} value={room.id}>
                    {room.name}
                  </MenuItem>
                ))
              }
            </Select>
          </FormControl>
        </Grid>
        
        <Grid item xs={12} md={4}>
          <Typography variant="subtitle1" fontWeight={500}>Select Bed Type</Typography>
          <FormControl fullWidth sx={{ mt: 2 }} disabled={!roomType}>
            <InputLabel id="bed-type-select-label">Bed Type</InputLabel>
            <Select
              labelId="bed-type-select-label"
              id="bed-type-select"
              value={bedType}
              label="Bed Type"
              onChange={(e) => {
                const selected = e.target.value;
                setBedType(selected);
                
                // Set occupancy type based on bed's max occupancy
                const selectedBed = mockBedTypes.find(bed => bed.id === selected);
                if (selectedBed) {
                  if (selectedBed.max_occupancy === 1) {
                    setOccupancyType('single');
                  } else if (selectedBed.max_occupancy === 2) {
                    setOccupancyType('double');
                  } else if (selectedBed.max_occupancy === 3) {
                    setOccupancyType('triple');
                  }
                }
              }}
            >
              <MenuItem value="">
                <em>Select a bed type</em>
              </MenuItem>
              {mockBedTypes
                .filter(bed => bed.room_type_id === roomType)
                .map((bed) => (
                  <MenuItem key={bed.id} value={bed.id}>
                    {bed.name} (Max: {bed.max_occupancy} person{bed.max_occupancy > 1 ? 's' : ''})
                  </MenuItem>
                ))
              }
            </Select>
          </FormControl>
        </Grid>
      </Grid>
      
      {/* Occupancy-Based Meal Plan Selection */}
      <Card elevation={3} sx={{ mb: 3, mt: 3 }}>
        <CardContent>
          <Typography variant="h6" gutterBottom>Room Details & Meal Selection</Typography>
          
          <Grid container spacing={3}>
            {/* Left Column - Room Occupancy */}
            <Grid item xs={12} md={6}>
              <Box sx={{ 
                p: 2, 
                bgcolor: 'rgba(53, 84, 209, 0.05)', 
                borderRadius: '8px',
                height: '100%'
              }}>
                {/* Max Occupancy */}
                <Box sx={{ display: 'flex', alignItems: 'center', mb: 2 }}>
                  <Avatar sx={{ bgcolor: '#3554D1', mr: 1 }}>
                    <PersonIcon />
                  </Avatar>
                  <Typography variant="subtitle1" fontWeight={500}>
                    Max Occupancy ({bedType ? mockBedTypes.find(bed => bed.id === bedType)?.max_occupancy || '1' : '1'})
                  </Typography>
                </Box>
                
                {/* Bed Icons */}
                <Box sx={{ display: 'flex', mb: 3 }}>
                  {Array.from({ length: bedType ? mockBedTypes.find(bed => bed.id === bedType)?.max_occupancy || 1 : 1 }).map((_, index) => (
                    <Avatar 
                      key={index}
                      sx={{ 
                        bgcolor: 'white', 
                        color: '#3554D1', 
                        border: '1px solid #3554D1',
                        mr: 1
                      }}
                    >
                      <HotelIcon />
                    </Avatar>
                  ))}
                </Box>
                
                {/* Total Occupancy */}
                <Box sx={{ display: 'flex', alignItems: 'center', mb: 2 }}>
                  <PersonIcon sx={{ color: '#3554D1', mr: 1 }} />
                  <Typography variant="subtitle1" fontWeight={500}>
                    Total Occupancy: {parseInt(searchCriteria?.guests?.adults || 1)}
                  </Typography>
                </Box>
                
                {/* Adults Distribution */}
                <Box sx={{ 
                  p: 2, 
                  bgcolor: 'white', 
                  borderRadius: '8px',
                  mb: 2
                }}>
                  <Typography variant="subtitle2" sx={{ mb: 1 }}>
                    Adults ({searchCriteria?.guests?.adults || 1})
                  </Typography>
                  
                  <Box sx={{ display: 'flex', mt: 1, gap: 2 }}>
                    <Box sx={{ 
                      display: 'flex', 
                      alignItems: 'center', 
                      bgcolor: 'rgba(53, 84, 209, 0.1)',
                      borderRadius: '20px',
                      px: 2,
                      py: 0.5
                    }}>
                      <Typography variant="body2" sx={{ mr: 1 }}>Male</Typography>
                      <Avatar sx={{ bgcolor: '#3554D1', width: 30, height: 30 }}>
                        <PersonIcon fontSize="small" />
                      </Avatar>
                    </Box>
                    
                    <Box sx={{ 
                      display: 'flex', 
                      alignItems: 'center', 
                      bgcolor: 'rgba(233, 30, 99, 0.1)',
                      borderRadius: '20px',
                      px: 2,
                      py: 0.5
                    }}>
                      <Typography variant="body2" sx={{ mr: 1 }}>Female</Typography>
                      <Avatar sx={{ bgcolor: '#E91E63', width: 30, height: 30 }}>
                        <WomanIcon fontSize="small" />
                      </Avatar>
                    </Box>
                  </Box>
                </Box>
                
                {/* Baby Cot */}
                <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>
                  <Box sx={{ display: 'flex', alignItems: 'center' }}>
                    <BabyChangingStationIcon sx={{ color: babyCotSelected ? '#3554D1' : 'text.secondary', mr: 1 }} />
                    <Typography variant="subtitle1">Baby Cot</Typography>
                  </Box>
                  <Checkbox
                    checked={babyCotSelected}
                    onChange={handleBabyCotToggle}
                    color="primary"
                  />
                </Box>
              </Box>
            </Grid>
            
            {/* Right Column - Meal Plans */}
            <Grid item xs={12} md={6}>
              <Box sx={{ height: '100%', display: 'flex', flexDirection: 'column' }}>
                <Typography variant="subtitle1" fontWeight={500} sx={{ mb: 2 }}>Select Meal Plan</Typography>
                
                <FormControl fullWidth>
                  <InputLabel id="meal-plan-select-label">Meal Plan</InputLabel>
                  <Select
                    labelId="meal-plan-select-label"
                    id="meal-plan-select"
                    value={mealPlan}
                    label="Meal Plan"
                    onChange={(e) => handleMealPlanCardSelect(e.target.value)}
                  >
                    <MenuItem value="self">Room Only</MenuItem>
                    <MenuItem value="breakfast">Room with Breakfast</MenuItem>
                    <MenuItem value="lunch">Room with Lunch</MenuItem>
                    <MenuItem value="dinner">Room with Dinner</MenuItem>
                    <MenuItem value="fullboard">Room with Full Board</MenuItem>
                    <MenuItem value="allinclusive">Room with All Inclusive</MenuItem>
                  </Select>
                </FormControl>
                
                {/* Meal Plan Cards - Similar to screenshot */}
                <Box sx={{ mt: 3, flexGrow: 1, display: 'flex', flexDirection: 'column', gap: 2 }}>
                  {/* Room Only Card */}
                  <Card elevation={2} sx={{ 
                    borderRadius: 2,
                    border: mealPlan === 'self' ? '2px solid #3554D1' : 'none'
                  }}>
                    <Box sx={{ bgcolor: '#3554D1', color: 'white', py: 1.5, px: 2 }}>
                      <Typography variant="subtitle1">Room Only</Typography>
                    </Box>
                    <Box sx={{ 
                      display: 'flex', 
                      justifyContent: 'space-between', 
                      alignItems: 'center',
                      py: 2,
                      px: 2,
                      bgcolor: 'rgba(53, 84, 209, 0.05)'
                    }}>
                      <Box sx={{ 
                        py: 1,
                        px: 3,
                        bgcolor: 'rgba(255, 255, 255, 0.7)',
                        borderRadius: '4px'
                      }}>
                        <Typography variant="body2" color="text.secondary">
                          Price available on request
                        </Typography>
                      </Box>
                      <Button 
                        variant="contained" 
                        size="small"
                        color="primary"
                        onClick={() => handleMealPlanCardSelect('self')}
                        startIcon={<AddIcon />}
                      >
                        Select
                      </Button>
                    </Box>
                  </Card>
                  
                  {/* Room with Breakfast Card */}
                  <Card elevation={2} sx={{ 
                    borderRadius: 2,
                    border: mealPlan === 'breakfast' ? '2px solid #3554D1' : 'none'
                  }}>
                    <Box sx={{ bgcolor: '#3554D1', color: 'white', py: 1.5, px: 2 }}>
                      <Typography variant="subtitle1">Room with Breakfast</Typography>
                    </Box>
                    <Box sx={{ 
                      display: 'flex', 
                      justifyContent: 'space-between', 
                      alignItems: 'center',
                      py: 2,
                      px: 2,
                      bgcolor: 'rgba(53, 84, 209, 0.05)'
                    }}>
                      <Box sx={{ 
                        py: 1,
                        px: 3,
                        bgcolor: 'rgba(255, 255, 255, 0.7)',
                        borderRadius: '4px'
                      }}>
                        <Typography variant="body2" color="text.secondary">
                          Price available on request
                        </Typography>
                      </Box>
                      <Button 
                        variant="contained" 
                        size="small"
                        color="primary"
                        onClick={() => handleMealPlanCardSelect('breakfast')}
                        startIcon={<AddIcon />}
                      >
                        Select
                      </Button>
                    </Box>
                  </Card>
                  
                  {/* Room with Lunch Card */}
                  <Card elevation={2} sx={{ 
                    borderRadius: 2,
                    border: mealPlan === 'lunch' ? '2px solid #3554D1' : 'none'
                  }}>
                    <Box sx={{ bgcolor: '#3554D1', color: 'white', py: 1.5, px: 2 }}>
                      <Typography variant="subtitle1">Room with Lunch</Typography>
                    </Box>
                    <Box sx={{ 
                      display: 'flex', 
                      justifyContent: 'space-between', 
                      alignItems: 'center',
                      py: 2,
                      px: 2,
                      bgcolor: 'rgba(53, 84, 209, 0.05)'
                    }}>
                      <Box sx={{ 
                        py: 1,
                        px: 3,
                        bgcolor: 'rgba(255, 255, 255, 0.7)',
                        borderRadius: '4px'
                      }}>
                        <Typography variant="body2" color="text.secondary">
                          Price available on request
                        </Typography>
                      </Box>
                      <Button 
                        variant="contained" 
                        size="small"
                        color="primary"
                        onClick={() => handleMealPlanCardSelect('lunch')}
                        startIcon={<AddIcon />}
                      >
                        Select
                      </Button>
                    </Box>
                  </Card>
                </Box>
              </Box>
            </Grid>
          </Grid>
        </CardContent>
      </Card>
      
      {/* Hotel Details Card */}
      <Card elevation={3} sx={{ mb: 3 }}>
        <Grid container>
          <Grid item xs={12} md={4}>
            <CardMedia
              component="img"
              height={200}
              image={hotelDetails.image}
              alt={hotelDetails.name}
            />
          </Grid>
          <Grid item xs={12} md={8}>
            <CardContent>
              <Typography variant="h5" gutterBottom>{hotelDetails.name}</Typography>
              <Typography variant="body2" color="text.secondary" gutterBottom>
                {hotelDetails.location}
              </Typography>
              
              <Divider sx={{ my: 2 }} />
              
              {/* Stay Nights */}
              <Typography variant="subtitle1" fontWeight={500}>Stay Nights</Typography>
              <Box sx={{ mt: 2 }}>
                {dates.slice(0, -1).map((date, index) => (
                  <FormControlLabel 
                    key={index} 
                    control={<Checkbox defaultChecked />} 
                    label={`${index + 1}st N (${date.format('DD MMM')})`} 
                    sx={{ display: 'block', mb: 0.5 }}
                  />
                ))}
              </Box>
            </CardContent>
          </Grid>
        </Grid>
      </Card>
      
      {/* Room Occupancy Details */}
      <Card elevation={3} sx={{ mb: 3 }}>
        <CardContent>
          <Typography variant="h6" gutterBottom>Room Occupancy</Typography>
          
          {/* Occupancy Summary */}
          <Box sx={{ 
            display: 'flex', 
            flexDirection: 'column',
            gap: 1.5, 
            mt: 1,
            mb: 3,
            p: 2,
            bgcolor: 'rgba(53, 84, 209, 0.05)',
            borderRadius: '8px'
          }}>
            <Box sx={{ display: 'flex', alignItems: 'center' }}>
              <PersonIcon sx={{ color: '#3554D1', mr: 1 }} />
              <Typography variant="subtitle1" fontWeight={500}>
                Total Occupancy: {parseInt(searchCriteria?.guests?.adults || 1) + parseInt(searchCriteria?.guests?.children || 0)}
              </Typography>
            </Box>
            
            {/* Adults */}
                          <Box sx={{ pl: 4 }}>
                <Typography variant="body2" gutterBottom>
                  Adults: {searchCriteria?.guests?.adults || 1}
                </Typography>
                
                <Grid container spacing={2} sx={{ mt: 1 }}>
                  <Grid item xs={6}>
                    <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                      <Avatar sx={{ bgcolor: '#3554D1', width: 28, height: 28 }}>
                        <PersonIcon fontSize="small" />
                      </Avatar>
                      <TextField 
                        type="number"
                        variant="outlined"
                        size="small"
                        label="Male"
                        value={adultDistribution.male}
                        onChange={(e) => {
                          const newMale = parseInt(e.target.value) || 0;
                          const totalAdults = parseInt(searchCriteria?.guests?.adults || 1);
                          // Ensure total doesn't exceed available adults
                          if (newMale <= totalAdults) {
                            setAdultDistribution({
                              male: newMale,
                              female: totalAdults - newMale
                            });
                          }
                        }}
                        InputProps={{ 
                          inputProps: { 
                            min: 0, 
                            max: searchCriteria?.guests?.adults || 1 
                          } 
                        }}
                        sx={{ width: '80px' }}
                      />
                    </Box>
                  </Grid>
                  <Grid item xs={6}>
                    <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                      <Avatar sx={{ bgcolor: '#E91E63', width: 28, height: 28 }}>
                        <WomanIcon fontSize="small" />
                      </Avatar>
                      <TextField 
                        type="number"
                        variant="outlined"
                        size="small"
                        label="Female"
                        value={adultDistribution.female}
                        onChange={(e) => {
                          const newFemale = parseInt(e.target.value) || 0;
                          const totalAdults = parseInt(searchCriteria?.guests?.adults || 1);
                          // Ensure total doesn't exceed available adults
                          if (newFemale <= totalAdults) {
                            setAdultDistribution({
                              male: totalAdults - newFemale,
                              female: newFemale
                            });
                          }
                        }}
                        InputProps={{ 
                          inputProps: { 
                            min: 0, 
                            max: searchCriteria?.guests?.adults || 1 
                          } 
                        }}
                        sx={{ width: '80px' }}
                      />
                    </Box>
                  </Grid>
                </Grid>
            </Box>
            
            {/* Children if present */}
            {searchCriteria?.guests?.children > 0 && (
              <Box sx={{ pl: 4 }}>
                <Typography variant="body2" gutterBottom>
                  Children: {searchCriteria?.guests?.children}
                </Typography>
                <Box sx={{ display: 'flex', alignItems: 'center', mt: 1 }}>
                  <AvatarGroup max={5} sx={{ '& .MuiAvatar-root': { width: 28, height: 28, fontSize: '0.7rem' } }}>
                    {Array.from({ length: parseInt(searchCriteria?.guests?.children) }).map((_, i) => (
                      <Avatar 
                        key={`child-avatar-${i}`} 
                        sx={{ bgcolor: '#FF9800', color: 'white' }}
                      >
                        <ChildCareIcon fontSize="small" />
                      </Avatar>
                    ))}
                  </AvatarGroup>
                </Box>
              </Box>
            )}
            
            {/* Infants if present */}
            {searchCriteria?.guests?.infants > 0 && (
              <Box sx={{ pl: 4 }}>
                <Typography variant="body2" gutterBottom>
                  Infants: {searchCriteria?.guests?.infants}
                </Typography>
              </Box>
            )}
          </Box>
          
          {/* Room Configuration */}
          <Grid container spacing={2} sx={{ mb: 3 }}>
            <Grid item xs={6} md={2}>
              <Typography variant="subtitle2">Pax/room</Typography>
              <TextField 
                fullWidth 
                size="small" 
                defaultValue="2" 
                variant="outlined" 
                type="number"
                InputProps={{ inputProps: { min: 1 } }}
                sx={{ mt: 1 }}
              />
            </Grid>
            
            <Grid item xs={6} md={2}>
              <Typography variant="subtitle2">No. of rooms</Typography>
              <TextField 
                fullWidth 
                size="small" 
                defaultValue={Math.ceil((parseInt(searchCriteria?.guests?.adults || 1) + parseInt(searchCriteria?.guests?.children || 0)) / 2)} 
                variant="outlined" 
                type="number"
                InputProps={{ inputProps: { min: 1 } }}
                sx={{ mt: 1 }}
              />
            </Grid>
            
            <Grid item xs={6} sm={3} md={2}>
              <Typography variant="subtitle2">AWEB</Typography>
              <TextField 
                fullWidth 
                size="small" 
                defaultValue="0" 
                variant="outlined" 
                type="number"
                InputProps={{ inputProps: { min: 0 } }}
                sx={{ mt: 1 }}
              />
            </Grid>
            
            <Grid item xs={6} sm={3} md={2}>
              <Typography variant="subtitle2">CWEB</Typography>
              <TextField 
                fullWidth 
                size="small" 
                defaultValue="0" 
                variant="outlined" 
                type="number"
                InputProps={{ inputProps: { min: 0 } }}
                sx={{ mt: 1 }}
              />
            </Grid>
            
            <Grid item xs={6} sm={3} md={2}>
              <Typography variant="subtitle2">CNB</Typography>
              <TextField 
                fullWidth 
                size="small" 
                defaultValue="0" 
                variant="outlined" 
                type="number"
                InputProps={{ inputProps: { min: 0 } }}
                sx={{ mt: 1 }}
              />
            </Grid>
            
            <Grid item xs={6} sm={3} md={2}>
              <Typography variant="subtitle2">Comp Child</Typography>
              <Box sx={{ display: 'flex', alignItems: 'center', mt: 1 }}>
                <Typography variant="body2">Upto 5y</Typography>
                <Typography variant="caption" color="text.secondary" sx={{ ml: 1 }}>(OC)</Typography>
              </Box>
            </Grid>
          </Grid>
          
          {/* Meal Plan Summary */}
          <Box sx={{ mt: 3, pt: 3, borderTop: '1px solid #e0e0e0' }}>
            <Typography variant="h6" gutterBottom>Meal Plan Summary</Typography>
            
            <Grid container spacing={2}>
              <Grid item xs={12} md={6}>
                <Paper variant="outlined" sx={{ p: 2, borderRadius: 2 }}>
                  <Typography variant="subtitle2" gutterBottom>Group Meal Plan</Typography>
                  <Chip 
                    label={
                      mealPlan === 'self' ? 'Room Only' : 
                      mealPlan === 'breakfast' ? 'Room with Breakfast' :
                      mealPlan === 'lunch' ? 'Room with Lunch' :
                      mealPlan === 'dinner' ? 'Room with Dinner' :
                      mealPlan === 'fullboard' ? 'Room with Full Board' : 'All Inclusive'
                    } 
                    color="primary" 
                    sx={{ fontWeight: 'medium' }}
                  />
                </Paper>
              </Grid>
              
              <Grid item xs={12} md={6}>
                <Paper variant="outlined" sx={{ p: 2, borderRadius: 2 }}>
                  <Typography variant="subtitle2" gutterBottom>Individual Meal Plans</Typography>
                  <Box sx={{ display: 'flex', flexWrap: 'wrap', gap: 1 }}>
                    {mealPlanPerPerson.map((plan, index) => (
                      <Chip 
                        key={index}
                        label={`Person ${index + 1}: ${
                          plan === 'self' ? 'Room Only' : 
                          plan === 'breakfast' ? 'Breakfast' :
                          plan === 'lunch' ? 'Lunch' :
                          plan === 'dinner' ? 'Dinner' :
                          plan === 'fullboard' ? 'Full Board' : 'All Inclusive'
                        }`} 
                        variant="outlined"
                        size="small"
                        sx={{ fontWeight: 'medium' }}
                      />
                    ))}
                  </Box>
                </Paper>
              </Grid>
            </Grid>
          </Box>
          
          {/* Action Buttons */}
          <Box sx={{ display: 'flex', justifyContent: 'space-between', mt: 3 }}>
            <Button variant="outlined" color="primary" startIcon={<AddIcon />}>
              Add Similar Hotels
            </Button>
            
            <Box>
              <Button variant="outlined" color="primary" startIcon={<ContentCopyIcon />}>
                Duplicate
              </Button>
              <Button variant="outlined" color="error" startIcon={<DeleteIcon />} sx={{ ml: 1 }}>
                Remove
              </Button>
            </Box>
          </Box>
        </CardContent>
      </Card>
    </Box>
  );
} 